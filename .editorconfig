root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 120

[*.{java,xml}]
indent_style = space
indent_size = 4

[*.{json,properties,yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[mvnw]
indent_style = space
indent_size = 2

[mvnw.cmd]
end_of_line = crlf
indent_style = space
indent_size = 2
